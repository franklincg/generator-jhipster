+static void test_inflight_move_and_timeout(void)
+{
+	struct test_stream *ts;
+	struct filter_stream *fs;
+	setup();
+	tick();
+	ts = &test.streams[0];
+	spa_assert_se(ts->stream.filter->phase == MOVE_GUARD);
+	spa_assert_se(filter_move_stream(&test.client, ts->node, 3, 103) == 0);
+	settle();
+	spa_assert_se(ts->peer == 103);
+	spa_assert_se(spa_streq(ts->saved, "103"));
+	cleanup();
+
+	setup();
+	test.block_link = true;
+	settle();
+	ts = &test.streams[0];
+	fs = ts->stream.filter;
+	spa_assert_se(fs->phase == MOVE_WAIT);
+	spa_assert_se(fs->timer.callback != NULL);
+	fs->timer.callback(fs->timer.data);
+	settle();
+	spa_assert_se(!fs->guarded);
+	spa_assert_se(!fs->automatic);
+	spa_assert_se(test.loads == 1);
+	spa_assert_se(spa_streq(ts->saved, "original"));
+	cleanup();
+}
