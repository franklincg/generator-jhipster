diff --git a/src/modules/module-protocol-pulse/test-filter.c b/src/modules/module-protocol-pulse/test-filter.c
new file mode 100644
index 000000000..64ecec894
--- /dev/null
+++ b/src/modules/module-protocol-pulse/test-filter.c
@@ -0,0 +1,626 @@
+/* PipeWire */
+/* SPDX-License-Identifier: MIT */
+
+/* Run the policy against a deterministic asynchronous graph. Property updates,
+ * metadata echoes and links are deliberately delivered on separate turns. */
+#define pw_stream_get_properties test_stream_get_properties
+#define pw_stream_update_properties test_stream_update_properties
+#define pw_timer_queue_add test_timer_queue_add
+#define pw_timer_queue_cancel test_timer_queue_cancel
+#include "filter.c"
+
+struct spa_log_topic *const mod_topic = NULL;
+
+struct test_stream {
+	struct stream stream;
+	struct pw_properties *props, *observed, *metadata;
+	struct pw_node_info info;
+	struct pw_manager_object *node;
+	uint64_t peer;
+	char *saved;
+};
+
+static struct {
+	struct impl impl;
+	struct client client;
+	struct pw_manager manager;
+	struct pw_manager_object objects[32];
+	struct test_stream streams[3];
+	struct module *modules[16];
+	unsigned int n_objects, n_modules, loads, unloads, writes;
+	bool fail_load, block_link;
+	struct {
+		uint32_t subject;
+		const char *key;
+		char *value;
+	} events[128];
+	unsigned int n_events;
+} test;
+
+void broadcast_subscribe_event(struct impl *impl, uint32_t facility, uint32_t type, uint32_t id)
+{
+	spa_assert_se(facility == SUBSCRIPTION_EVENT_MODULE);
+	spa_assert_se(type == SUBSCRIPTION_EVENT_NEW);
+}
+
+int pw_manager_sync(struct pw_manager *manager)
+{
+	return 0;
+}
+
+static struct pw_manager_object *add_object(const char *name, const char *media_class)
+{
+	struct pw_manager_object *o = &test.objects[test.n_objects++];
+	spa_assert_se(test.n_objects <= SPA_N_ELEMENTS(test.objects));
+	o->id = test.n_objects;
+	o->serial = o->id + 100;
+	o->type = PW_TYPE_INTERFACE_Node;
+	o->permissions = PW_PERM_ALL;
+	o->props = pw_properties_new(PW_KEY_NODE_NAME, name, PW_KEY_MEDIA_CLASS, media_class, NULL);
+	spa_list_append(&test.manager.object_list, &o->link);
+	return o;
+}
+
+bool pw_manager_object_is_sink(struct pw_manager_object *o)
+{
+	return spa_streq(pw_properties_get(o->props, PW_KEY_MEDIA_CLASS), "Audio/Sink");
+}
+
+bool pw_manager_object_is_source(struct pw_manager_object *o)
+{
+	return spa_streq(pw_properties_get(o->props, PW_KEY_MEDIA_CLASS), "Audio/Source");
+}
+
+struct pw_manager_object *find_linked(struct pw_manager *manager, uint32_t id, enum pw_direction direction)
+{
+	size_t i;
+	for (i = 0; i < SPA_N_ELEMENTS(test.streams); i++)
+		if (test.streams[i].stream.id == id)
+			return find_serial(&test.client, test.streams[i].peer);
+	return NULL;
+}
+
+const struct pw_properties *test_stream_get_properties(struct pw_stream *stream)
+{
+	return ((struct test_stream *)stream)->props;
+}
+
+int test_stream_update_properties(struct pw_stream *stream, const struct spa_dict *dict)
+{
+	return pw_properties_update(((struct test_stream *)stream)->props, dict);
+}
+
+int test_timer_queue_add(struct pw_timer_queue *queue, struct pw_timer *timer, struct timespec *abs_time,
+	int64_t timeout, pw_timer_callback callback, void *data)
+{
+	timer->callback = callback;
+	timer->data = data;
+	return 0;
+}
+
+int test_timer_queue_cancel(struct pw_timer *timer)
+{
+	timer->callback = NULL;
+	return 0;
+}
+
+struct module *module_create(struct impl *impl, const char *name, const char *args)
+{
+	struct module *m = calloc(1, sizeof(*m));
+	spa_assert_se(spa_streq(name, "module-echo-cancel"));
+	spa_assert_se(strstr(args, "autoloaded=1") != NULL);
+	m->index = ++test.n_modules;
+	spa_assert_se(m->index < SPA_N_ELEMENTS(test.modules));
+	m->args = strdup(args);
+	spa_hook_list_init(&m->listener_list);
+	test.modules[m->index] = m;
+	return m;
+}
+
+void module_add_listener(
+	struct module *m, struct spa_hook *listener, const struct module_events *events, void *data)
+{
+	spa_hook_list_append(&m->listener_list, listener, events, data);
+}
+
+int module_load(struct module *m)
+{
+	struct pw_manager_object *sink, *source;
+	test.loads++;
+	if (test.fail_load)
+		return -ENOENT;
+	sink = add_object("filter-sink", "Audio/Sink");
+	source = add_object("filter-source", "Audio/Source");
+	pw_properties_set(sink->props, "pulse.filter", "echo-cancel");
+	pw_properties_set(source->props, "pulse.filter", "echo-cancel");
+	pw_properties_setf(sink->props, "pulse.module.id", "%u", m->index);
+	pw_properties_setf(source->props, "pulse.module.id", "%u", m->index);
+	return 0;
+}
+
+int module_unload(struct module *m)
+{
+	size_t i;
+	for (i = 0; i < test.n_objects; i++) {
+		uint32_t index;
+		struct pw_manager_object *o = &test.objects[i];
+		if (spa_atou32(pw_properties_get(o->props, "pulse.module.id"), &index, 10) &&
+			index == m->index)
+			o->removing = true;
+	}
+	module_emit_destroy(m);
+	test.modules[m->index] = NULL;
+	free((char *)m->args);
+	free(m);
+	test.unloads++;
+	return 0;
+}
+
+void module_schedule_unload(struct module *m)
+{
+	m->unloading = true;
+}
+
+int pw_manager_set_metadata(struct pw_manager *manager, struct pw_manager_object *metadata, uint32_t subject,
+	const char *key, const char *type, const char *format, ...)
+{
+	unsigned int i = test.n_events++;
+	va_list args;
+	spa_assert_se(i < SPA_N_ELEMENTS(test.events));
+	test.events[i].subject = subject;
+	test.events[i].key = key;
+	if (type) {
+		va_start(args, format);
+		spa_assert_se(vasprintf(&test.events[i].value, format, args) >= 0);
+		va_end(args);
+	}
+	test.writes++;
+	return 0;
+}
+
+static void tick(void)
+{
+	unsigned int i, j, n;
+	/* Registry property updates arrive before the corresponding metadata. */
+	for (i = 0; i < SPA_N_ELEMENTS(test.streams); i++) {
+		struct test_stream *ts = &test.streams[i];
+		if (!ts->props)
+			continue;
+		pw_properties_clear(ts->observed);
+		pw_properties_update(ts->observed, &ts->props->dict);
+	}
+	n = test.n_events;
+	test.n_events = 0;
+	for (i = 0; i < n; i++) {
+		for (j = 0; j < SPA_N_ELEMENTS(test.streams); j++) {
+			struct test_stream *ts = &test.streams[j];
+			if (!ts->props || ts->stream.id != test.events[i].subject)
+				continue;
+			pw_properties_set(ts->metadata, test.events[i].key, test.events[i].value);
+			if (!spa_streq(pw_properties_get(ts->observed, "state.restore-target"), "false")) {
+				free(ts->saved);
+				ts->saved = test.events[i].value ? strdup(test.events[i].value) : NULL;
+			}
+			filter_metadata(
+				&test.client, ts->stream.id, test.events[i].key, test.events[i].value);
+		}
+		free(test.events[i].value);
+		test.events[i].value = NULL;
+	}
+	for (i = 0; i < SPA_N_ELEMENTS(test.streams); i++) {
+		struct test_stream *ts = &test.streams[i];
+		const char *value;
+		uint64_t serial;
+		if (!ts->props || test.block_link)
+			continue;
+		value = pw_properties_get(ts->metadata, METADATA_TARGET_OBJECT);
+		if (value && spa_atou64(value, &serial, 10) && find_serial(&test.client, serial))
+			ts->peer = serial;
+		else if (!value || spa_streq(value, "-1")) {
+			const char *name = ts->stream.direction == PW_DIRECTION_OUTPUT
+						   ? test.client.default_sink
+						   : test.client.default_source;
+			for (j = 0; j < test.n_objects; j++)
+				if (spa_streq(
+					    pw_properties_get(test.objects[j].props, PW_KEY_NODE_NAME), name))
+					ts->peer = test.objects[j].serial;
+		}
+	}
+	for (i = 1; i <= test.n_modules; i++)
+		if (test.modules[i] && test.modules[i]->unloading)
+			module_unload(test.modules[i]);
+	filter_process(&test.impl);
+}
+
+static void settle(void)
+{
+	unsigned int i;
+	for (i = 0; i < 12; i++)
+		tick();
+}
+
+static void setup(void)
+{
+	unsigned int i;
+	spa_zero(test);
+	spa_list_init(&test.manager.object_list);
+	test.client.impl = &test.impl;
+	test.client.manager = &test.manager;
+	test.client.default_sink = "speaker";
+	test.client.default_source = "microphone";
+	test.impl.defs.allow_module_loading = true;
+	add_object("speaker", "Audio/Sink");
+	add_object("microphone", "Audio/Source");
+	add_object("phone", "Audio/Sink");
+	test.client.metadata_default = &test.objects[2];
+	test.objects[2].proxy = (struct pw_proxy *)&test;
+	pw_properties_set(test.objects[2].props, PW_KEY_DEVICE_INTENDED_ROLES, "music phone");
+	for (i = 0; i < 2; i++) {
+		struct test_stream *ts = &test.streams[i];
+		ts->props = pw_properties_new(
+			"filter.want", "echo-cancel", PW_KEY_MEDIA_ROLE, "Communication", NULL);
+		ts->observed = pw_properties_copy(ts->props);
+		ts->metadata = pw_properties_new(NULL, NULL);
+		ts->node = add_object("stream", i == 0 ? "Stream/Output/Audio" : "Stream/Input/Audio");
+		ts->info.props = &ts->observed->dict;
+		ts->node->info = &ts->info;
+		ts->stream.id = ts->node->id;
+		ts->stream.client = &test.client;
+		ts->stream.impl = &test.impl;
+		ts->stream.direction = i == 0 ? PW_DIRECTION_OUTPUT : PW_DIRECTION_INPUT;
+		ts->stream.stream = (struct pw_stream *)ts;
+		ts->peer = test.objects[i].serial;
+		ts->saved = strdup("original");
+		spa_assert_se(ensure_stream(&ts->stream) != NULL);
+	}
+}
+
+static void cleanup(void)
+{
+	unsigned int i;
+	for (i = 0; i < SPA_N_ELEMENTS(test.streams); i++) {
+		struct test_stream *ts = &test.streams[i];
+		filter_stream_free(&ts->stream);
+		pw_properties_free(ts->props);
+		pw_properties_free(ts->observed);
+		pw_properties_free(ts->metadata);
+		free(ts->saved);
+	}
+	for (i = 1; i <= test.n_modules; i++)
+		if (test.modules[i])
+			module_unload(test.modules[i]);
+	for (i = 0; i < test.n_objects; i++)
+		pw_properties_free(test.objects[i].props);
+	for (i = 0; i < test.n_events; i++)
+		free(test.events[i].value);
+	pw_properties_free(test.client.props);
+}
+
+static void test_heuristics(void)
+{
+	struct filter_stream *fs;
+	struct pw_properties *props;
+	setup();
+	fs = test.streams[0].stream.filter;
+	props = test.streams[0].props;
+	spa_assert_se(wants_echo_cancel(fs, &test.objects[0]));
+	spa_assert_se(fs->heuristic);
+	spa_assert_se(!wants_echo_cancel(fs, &test.objects[2]));
+	spa_assert_se(pw_properties_get(props, "filter.apply") == NULL);
+	pw_properties_set(props, "filter.apply", "echo-cancel");
+	spa_assert_se(wants_echo_cancel(fs, &test.objects[2]));
+	pw_properties_set(props, "filter.apply", "");
+	spa_assert_se(!wants_echo_cancel(fs, &test.objects[0]));
+	pw_properties_set(props, "filter.apply", "other-filter");
+	spa_assert_se(!wants_echo_cancel(fs, &test.objects[0]));
+	pw_properties_set(props, "filter.apply", "echo-cancel");
+	pw_properties_set(props, "filter.suppress", "echo-cancel");
+	spa_assert_se(!wants_echo_cancel(fs, &test.objects[0]));
+	spa_assert_se(!has_role("headphone telephone", "phone"));
+	spa_assert_se(has_role("  music phone  ", "phone"));
+	cleanup();
+}
