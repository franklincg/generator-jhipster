+static void test_pair_and_restore(void)
+{
+	struct filter_stream *a, *b;
+	setup();
+	settle();
+	a = test.streams[0].stream.filter;
+	b = test.streams[1].stream.filter;
+	spa_assert_se(test.loads == 1);
+	spa_assert_se(a->filter == b->filter);
+	spa_assert_se(a->automatic && b->automatic);
+	spa_assert_se(a->phase == MOVE_IDLE && b->phase == MOVE_IDLE);
+	spa_assert_se(spa_streq(test.streams[0].saved, "original"));
+	spa_assert_se(spa_streq(test.streams[1].saved, "original"));
+	pw_properties_set(test.streams[0].props, "filter.want", NULL);
+	pw_properties_set(test.streams[1].props, "filter.want", NULL);
+	settle();
+	spa_assert_se(!a->automatic && !b->automatic);
+	spa_assert_se(!a->guarded && !b->guarded);
+	spa_assert_se(test.streams[0].peer == test.objects[0].serial);
+	spa_assert_se(test.streams[1].peer == test.objects[1].serial);
+	spa_assert_se(spa_streq(test.streams[0].saved, "original"));
+	spa_assert_se(test.unloads == 1);
+	cleanup();
+}
