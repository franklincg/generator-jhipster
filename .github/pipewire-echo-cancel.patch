+	module_unload(ts->stream.filter->filter->module);
+	settle();
+	spa_assert_se(!ts->stream.filter->automatic);
+	spa_assert_se(!ts->stream.filter->guarded);
+	spa_assert_se(spa_streq(ts->saved, "original"));
+	cleanup();
