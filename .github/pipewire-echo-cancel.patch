diff --git a/src/modules/module-protocol-pulse/filter.c b/src/modules/module-protocol-pulse/filter.c
new file mode 100644
index 000000000..1f0c8f7cf
--- /dev/null
+++ b/src/modules/module-protocol-pulse/filter.c
@@ -0,0 +1,711 @@
+/* PipeWire */
+/* SPDX-License-Identifier: MIT */
+
+#include <ctype.h>
+
+#include <spa/utils/string.h>
+
+#include "client.h"
+#include "collect.h"
+#include "defs.h"
+#include "filter.h"
+#include "internal.h"
+#include "log.h"
+#include "manager.h"
+#include "module.h"
+#include "stream.h"
+
+/* Echo cancellation needs both halves of a conversation. Keep the underlying
+ * route separate from the temporary metadata used to route through the filter.
+ * In particular, never pass an automatic move through the user move handler:
+ * moving to the default there deliberately forgets the preferred device. */
+struct filter {
+	struct module *module;
+	struct spa_hook listener;
+	unsigned int ref;
+	uint64_t sink, source;
+	char *parameters;
+	bool failed;
+};
+
+struct filter_stream {
+	struct filter_stream *next;
+	struct stream *stream;
+	struct filter *filter;
+	struct pw_properties *target;
+	struct pw_properties *pending;
+	struct pw_properties *metadata;
+	char *restore_target;
+	struct pw_timer timer;
+	uint64_t master;
+	uint64_t destination;
+	unsigned int echoes;
+	enum { MOVE_IDLE, MOVE_GUARD, MOVE_WAIT, MOVE_UNGUARD, MOVE_USER, MOVE_ROLLBACK } phase;
+	bool automatic;
+	bool restoring;
+	bool heuristic;
+	bool manual;
+	bool wanted;
+	bool guarded;
+};
+
+static const char *target_keys[] = { METADATA_TARGET_NODE, METADATA_TARGET_OBJECT };
+
+static const char *object_property(struct pw_manager_object *o, const char *key)
+{
+	struct pw_node_info *info = o->info;
+	if (info && info->props)
+		return spa_dict_lookup(info->props, key);
+	return o->props ? pw_properties_get(o->props, key) : NULL;
+}
+
+static struct pw_manager_object *find_serial(struct client *client, uint64_t serial)
+{
+	struct pw_manager_object *o;
+	if (client->manager)
+		spa_list_for_each(o, &client->manager->object_list, link)
+			if (!o->removing && o->serial == serial)
+				return o;
+	return NULL;
+}
+
+static struct pw_manager_object *stream_object(struct stream *s)
+{
+	struct pw_manager_object *o;
+	if (s->client->manager && s->stream)
+		spa_list_for_each(o, &s->client->manager->object_list, link)
+			if (!o->removing && o->id == s->id && spa_streq(o->type, PW_TYPE_INTERFACE_Node))
+				return o;
+	return NULL;
+}
+
+static struct filter_stream *ensure_stream(struct stream *s)
+{
+	struct filter_stream *fs;
+	if ((fs = s->filter) != NULL)
+		return fs;
+	if ((fs = calloc(1, sizeof(*fs))) == NULL)
+		return NULL;
+	fs->target = pw_properties_new(NULL, NULL);
+	fs->pending = pw_properties_new(NULL, NULL);
+	fs->metadata = pw_properties_new(NULL, NULL);
+	if (fs->target == NULL || fs->pending == NULL || fs->metadata == NULL) {
+		pw_properties_free(fs->target);
+		pw_properties_free(fs->pending);
+		pw_properties_free(fs->metadata);
+		free(fs);
+		return NULL;
+	}
+	fs->stream = s;
+	fs->next = s->impl->filter_streams;
+	s->impl->filter_streams = fs;
+	/* PulseAudio merges client properties into each new stream. Inherit the
+	 * filter request and grouping keys here as well (stream values win). */
+	if (s->client->props && s->stream) {
+		static const char *keys[] = { "filter.want", "filter.apply", "filter.suppress",
+			"filter.apply.echo-cancel.parameters", PW_KEY_MEDIA_ROLE, PW_KEY_APP_ID,
+			PW_KEY_APP_NAME };
+		struct spa_dict_item items[SPA_N_ELEMENTS(keys)];
+		uint32_t n = 0, i;
+		const struct pw_properties *props = pw_stream_get_properties(s->stream);
+		for (i = 0; i < SPA_N_ELEMENTS(keys); i++) {
+			const char *value = pw_properties_get(s->client->props, keys[i]);
+			if (value && pw_properties_get(props, keys[i]) == NULL)
+				items[n++] = SPA_DICT_ITEM_INIT(keys[i], value);
+		}
+		pw_stream_update_properties(s->stream, &SPA_DICT_INIT(items, n));
+	}
+	return s->filter = fs;
+}
+
+static void promote_stream(struct filter_stream *fs)
+{
+	struct filter_stream **p;
+	for (p = &fs->stream->impl->filter_streams; *p != fs; p = &(*p)->next)
+		;
+	*p = fs->next;
+	fs->next = fs->stream->impl->filter_streams;
+	fs->stream->impl->filter_streams = fs;
+}
+
+static void filter_destroyed(void *data)
+{
+	struct filter *f = data;
+	spa_hook_remove(&f->listener);
+	f->module = NULL;
+}
+
+static const struct module_events filter_events = {
+	VERSION_MODULE_EVENTS,
+	.destroy = filter_destroyed,
+};
+
+static void filter_unref(struct filter *f)
+{
+	if (f == NULL || --f->ref > 0)
+		return;
+	if (f->module) {
+		spa_hook_remove(&f->listener);
+		module_schedule_unload(f->module);
+	}
+	free(f->parameters);
+	free(f);
+}
+
+void filter_stream_free(struct stream *s)
+{
+	struct filter_stream *fs = s->filter, **p;
+	if (fs == NULL)
+		return;
+	for (p = &s->impl->filter_streams; *p != fs; p = &(*p)->next)
+		;
+	*p = fs->next;
+	pw_timer_queue_cancel(&fs->timer);
+	filter_unref(fs->filter);
+	pw_properties_free(fs->target);
+	pw_properties_free(fs->pending);
+	pw_properties_free(fs->metadata);
+	free(fs->restore_target);
+	free(fs);
+	s->filter = NULL;
+}
+
+void filter_stream_properties_changed(struct stream *s, const struct spa_dict *props)
+{
+	struct filter_stream *fs = ensure_stream(s);
+	const struct spa_dict_item *item;
+	if (fs == NULL)
+		return;
+	/* A client writing filter.apply takes ownership, even if the value happens
+	 * to equal the one previously installed by the heuristics. */
+	spa_dict_for_each(item, props)
+		if (spa_streq(item->key, "filter.apply")) {
+			fs->heuristic = false;
+			struct spa_dict_item marker = SPA_DICT_ITEM_INIT("filter.heuristics", NULL);
+			pw_stream_update_properties(s->stream, &SPA_DICT_INIT(&marker, 1));
+			break;
+		}
+}
+
+static void set_property(struct stream *s, const char *key, const char *value)
+{
+	struct spa_dict_item item = SPA_DICT_ITEM_INIT(key, value);
+	pw_stream_update_properties(s->stream, &SPA_DICT_INIT(&item, 1));
+}
+
+static bool has_role(const char *roles, const char *role)
+{
+	size_t len = strlen(role), n;
+	if (roles == NULL)
+		return false;
+	while (*roles) {
+		roles += strspn(roles, " ");
+		n = strcspn(roles, " ");
+		if (n == len && strncmp(roles, role, n) == 0)
+			return true;
+		roles += n;
+	}
+	return false;
+}
+
+static bool wants_echo_cancel(struct filter_stream *fs, struct pw_manager_object *master)
+{
+	struct stream *s = fs->stream;
+	const struct pw_properties *props = pw_stream_get_properties(s->stream);
+	const char *apply = pw_properties_get(props, "filter.apply");
+	const char *want = pw_properties_get(props, "filter.want");
+	bool phone = has_role(object_property(master, PW_KEY_DEVICE_INTENDED_ROLES), "phone");
+
+	if (apply == NULL || fs->heuristic) {
+		if (phone) {
+			if (fs->heuristic && spa_streq(apply, "echo-cancel")) {
+				set_property(s, "filter.apply", NULL);
+				set_property(s, "filter.heuristics", NULL);
+				fs->heuristic = false;
+			}
+		} else if (!spa_streq(apply, want)) {
+			set_property(s, "filter.apply", want);
+			set_property(s, "filter.heuristics", want ? "1" : NULL);
+			fs->heuristic = want != NULL;
+		}
+	}
+	apply = pw_properties_get(props, "filter.apply");
+	return spa_streq(apply, "echo-cancel") &&
+	       !spa_streq(pw_properties_get(props, "filter.suppress"), apply);
+}
+
+static bool same_group(struct filter_stream *a, struct filter_stream *b)
+{
+	static const char *keys[] = { PW_KEY_MEDIA_ROLE, PW_KEY_APP_ID, PW_KEY_APP_NAME, PW_KEY_MEDIA_NAME };
+	const struct pw_properties *pa = pw_stream_get_properties(a->stream->stream);
+	const struct pw_properties *pb = pw_stream_get_properties(b->stream->stream);
+	size_t i;
+	for (i = 0; i < SPA_N_ELEMENTS(keys); i++) {
+		const char *va = pw_properties_get(pa, keys[i]);
+		const char *vb = pw_properties_get(pb, keys[i]);
+		if (va || vb)
+			return spa_streq(va, vb);
+	}
+	return true;
+}
+
+static struct pw_manager_object *find_master(struct filter_stream *fs)
+{
+	struct stream *s = fs->stream;
+	struct client *client = s->client;
+	struct pw_manager_object *o, *best = NULL;
+	const char *target, *name;
+	uint64_t serial;
+	bool by_id = false, sink = s->direction == PW_DIRECTION_OUTPUT;
+	int32_t priority = INT32_MIN;
+
+	if (!fs->automatic && fs->phase == MOVE_IDLE) {
+		o = find_linked(client->manager, s->id, s->direction);
+		return o && !o->removing ? o : NULL;
+	}
+	target = pw_properties_get(fs->target, METADATA_TARGET_OBJECT);
+	if (target == NULL) {
+		target = pw_properties_get(fs->target, METADATA_TARGET_NODE);
+		by_id = target != NULL;
+	}
+	if (target == NULL)
+		target = pw_properties_get(pw_stream_get_properties(s->stream), PW_KEY_TARGET_OBJECT);
+	if (spa_streq(target, "-1"))
+		target = NULL;
+	name = sink ? client->default_sink : client->default_source;
+	spa_list_for_each(o, &client->manager->object_list, link) {
+		int32_t p = 0;
+		const char *node_name;
+		if (o->removing || !(sink ? pw_manager_object_is_sink(o) : pw_manager_object_is_source(o)))
+			continue;
+		node_name = object_property(o, PW_KEY_NODE_NAME);
+		if (target &&
+			(spa_streq(target, node_name) ||
+				(spa_atou64(target, &serial, 10) && serial == (by_id ? o->id : o->serial))))
+			return o;
+		/* Explicitly selecting a filter is allowed, but it must not become
+		 * the fallback master of another automatically loaded filter. */
+		if (spa_streq(object_property(o, "pulse.filter"), "echo-cancel"))
+			continue;
+		if (spa_streq(name, node_name))
+			best = o, priority = INT32_MAX;
+		spa_atoi32(object_property(o, PW_KEY_PRIORITY_SESSION), &p, 10);
+		if (best == NULL || p > priority)
+			best = o, priority = p;
+	}
+	return best;
+}
+
+static struct pw_manager_object *filter_device(struct filter_stream *fs)
+{
+	struct pw_manager_object *o;
+	struct filter *f = fs->filter;
+	uint32_t index;
+	if (f == NULL || f->failed || f->module == NULL || f->module->unloading)
+		return NULL;
+	spa_list_for_each(o, &fs->stream->client->manager->object_list, link)
+		if (!o->removing &&
+			(fs->stream->direction == PW_DIRECTION_OUTPUT ? pw_manager_object_is_sink(o)
+								      : pw_manager_object_is_source(o)) &&
+			spa_atou32(object_property(o, "pulse.module.id"), &index, 10) &&
+			index == f->module->index)
+			return o;
+	return NULL;
+}
+
+/* module_args_add_props() tolerates unterminated quotes and escapes. Reject
+ * these before appending our routing arguments, so they cannot become part
+ * of a parameter value instead of overriding the supplied masters. */
+static bool parameters_valid(const char *p)
+{
+	if (p == NULL)
+		return true;
+	while (*p) {
+		char quote;
+		while (isspace((unsigned char)*p))
+			p++;
+		if (*p == '\0')
+			return true;
+		if ((p = strchr(p, '=')) == NULL)
+			return false;
+		p++;
+		quote = *p == '\'' || *p == '"' ? *p++ : ' ';
+		while (*p && *p != quote) {
+			if (*p == '\\' && *++p == '\0')
+				return false;
+			p++;
+		}
+		if (*p == '\0')
+			return quote == ' ';
+		p++;
+	}
+	return true;
+}
+
+static struct filter *get_filter(
+	struct filter_stream *fs, uint64_t sink, uint64_t source, const char *parameters)
+{
+	struct filter_stream *other;
+	struct filter *f;
+	char *args;
+	int res;
+
+	for (other = fs->stream->impl->filter_streams; other; other = other->next) {
+		f = other->filter;
+		if (f && f->sink == sink && f->source == source && spa_streq(f->parameters, parameters)) {
+			f->ref++;
+			return f;
+		}
+	}
+	if ((f = calloc(1, sizeof(*f))) == NULL)
+		return NULL;
+	f->ref = 1;
+	f->sink = sink;
+	f->source = source;
+	if (parameters && (f->parameters = strdup(parameters)) == NULL) {
+		filter_unref(f);
+		return NULL;
+	}
+	if (!parameters_valid(parameters)) {
+		pw_log_warn("invalid echo cancellation parameters");
+		return f;
+	}
+	/* Masters are serials, so node names cannot inject module arguments. The
+	 * routing arguments come last: filter parameters must not override them. */
+	res = asprintf(&args, "%s autoloaded=1 sink_master=%" PRIu64 " source_master=%" PRIu64,
+		parameters ? parameters : "", sink, source);
+	if (res < 0) {
+		filter_unref(f);
+		return NULL;
+	}
+	f->module = module_create(fs->stream->impl, "module-echo-cancel", args);
+	free(args);
+	if (f->module) {
+		module_add_listener(f->module, &f->listener, &filter_events, f);
+		if ((res = module_load(f->module)) < 0) {
+			pw_log_warn("failed to load echo cancellation: %s", spa_strerror(res));
+			module_unload(f->module);
+		} else {
+			f->module->loaded = true;
+			broadcast_subscribe_event(fs->stream->impl, SUBSCRIPTION_EVENT_MODULE,
+				SUBSCRIPTION_EVENT_NEW, f->module->index);
+		}
+	} else
+		pw_log_warn("failed to prepare echo cancellation: %s", strerror(errno));
+	/* Keep a failed instance until the request changes. Retrying on every
+	 * graph event would spin when the AEC plugin is not installed. */
+	return f;
+}
+
+static int write_targets(struct client *client, uint32_t id, struct pw_properties *props)
+{
+	size_t i;
+	int res;
+	for (i = 0; i < SPA_N_ELEMENTS(target_keys); i++) {
+		const char *value = pw_properties_get(props, target_keys[i]);
+		res = pw_manager_set_metadata(client->manager, client->metadata_default, id, target_keys[i],
+			value ? SPA_TYPE_INFO_BASE "Id" : NULL, value ? "%s" : NULL, value);
+		if (res < 0)
+			return res;
+	}
+	return 0;
+}
+
+static void unguard(struct filter_stream *fs)
+{
+	pw_timer_queue_cancel(&fs->timer);
+	set_property(fs->stream, "state.restore-target", fs->restore_target);
+	fs->phase = MOVE_UNGUARD;
+	pw_manager_sync(fs->stream->client->manager);
+}
+
+static int write_pending(struct filter_stream *fs)
+{
+	size_t i;
+	fs->echoes = 0;
+	for (i = 0; i < SPA_N_ELEMENTS(target_keys); i++)
+		if (!spa_streq(pw_properties_get(fs->pending, target_keys[i]),
+			    pw_properties_get(fs->metadata, target_keys[i])))
+			fs->echoes |= 1u << i;
+	return write_targets(fs->stream->client, fs->stream->id, fs->pending);
+}
+
+static void move_timeout(void *data)
+{
+	struct filter_stream *fs = data;
+	/* If policy cannot link the filter, restore the original metadata while
+	 * it is still protected. Do not leave a stream's preferences disabled. */
+	if (fs->phase == MOVE_WAIT) {
+		pw_properties_clear(fs->pending);
+		pw_properties_update(fs->pending, &fs->target->dict);
+		write_pending(fs);
+		fs->automatic = false;
+		fs->phase = MOVE_ROLLBACK;
+	}
+	if (fs->filter)
+		fs->filter->failed = true;
+	if (fs->phase != MOVE_ROLLBACK)
+		unguard(fs);
+	else
+		pw_manager_sync(fs->stream->client->manager);
+}
+
+static void begin_move(struct filter_stream *fs, struct pw_manager_object *dev, bool restore)
+{
+	struct stream *s = fs->stream;
+	const char *value;
+	if (!fs->guarded) {
+		value = pw_properties_get(pw_stream_get_properties(s->stream), "state.restore-target");
+		free(fs->restore_target);
+		fs->restore_target = value ? strdup(value) : NULL;
+		if (value && fs->restore_target == NULL)
+			return;
+		fs->guarded = true;
+	}
+	pw_properties_clear(fs->pending);
+	if (restore)
+		pw_properties_update(fs->pending, &fs->target->dict);
+	else {
+		pw_properties_setf(fs->pending, METADATA_TARGET_NODE, "%u", dev->id);
+		pw_properties_setf(fs->pending, METADATA_TARGET_OBJECT, "%" PRIu64, dev->serial);
+	}
+	fs->destination = dev ? dev->serial : 0;
+	fs->restoring = restore;
+	set_property(s, "state.restore-target", "false");
+	fs->phase = MOVE_GUARD;
+	pw_manager_sync(s->client->manager);
+	pw_timer_queue_add(s->impl->timer_queue, &fs->timer, NULL, 3 * SPA_NSEC_PER_SEC, move_timeout, fs);
+}
+
+/* Wait for the property update before publishing target metadata. Keep the
+ * guard while filtered; user moves are replayed after removing it. Restoring
+ * the property alone does not generate a target metadata event. */
+static bool advance_move(struct filter_stream *fs, struct pw_manager_object *node)
+{
+	struct stream *s = fs->stream;
+	struct pw_manager_object *peer, *target;
+	int res;
+	switch (fs->phase) {
+	case MOVE_GUARD:
+		if (!spa_streq(object_property(node, "state.restore-target"), "false"))
+			break;
+		res = write_pending(fs);
+		if (res < 0) {
+			pw_properties_clear(fs->pending);
+			pw_properties_update(fs->pending, &fs->target->dict);
+			write_pending(fs);
+			if (fs->filter)
+				fs->filter->failed = true;
+			fs->automatic = false;
+			fs->phase = MOVE_ROLLBACK;
+			break;
+		}
+		fs->automatic = !fs->restoring;
+		fs->phase = MOVE_WAIT;
+		break;
+	case MOVE_WAIT:
+		peer = find_linked(s->client->manager, s->id, s->direction);
+		if (fs->manual || (peer && peer->serial == fs->destination) ||
+			!find_serial(s->client, fs->destination)) {
+			if (fs->manual || fs->restoring)
+				unguard(fs);
+			else {
+				pw_timer_queue_cancel(&fs->timer);
+				fs->phase = MOVE_IDLE;
+			}
+		}
+		break;
+	case MOVE_USER:
+		peer = find_linked(s->client->manager, s->id, s->direction);
+		/* SET_DEFAULT followed immediately by MOVE may arrive before the
+		 * owner's default metadata. Resolve -1 again as defaults catch up. */
+		target = find_master(fs);
+		if (target == NULL || peer == target)
+			fs->phase = MOVE_IDLE;
+		break;
+	case MOVE_UNGUARD:
+		if (spa_streq(object_property(node, "state.restore-target"), fs->restore_target)) {
+			fs->guarded = false;
+			fs->phase = MOVE_IDLE;
+		}
+		break;
+	case MOVE_ROLLBACK:
+		if (fs->echoes == 0)
+			unguard(fs);
+		break;
+	case MOVE_IDLE:
+		if (fs->manual && fs->guarded) {
+			unguard(fs);
+			return true;
+		}
+		return false;
+	}
+	return fs->phase != MOVE_IDLE;
+}
+
+void filter_metadata(struct client *client, uint32_t subject, const char *key, const char *value)
+{
+	struct filter_stream *fs;
+	size_t i;
+	for (fs = client->impl->filter_streams; fs; fs = fs->next) {
+		if (fs->stream->client != client || fs->stream->id != subject)
+			continue;
+		for (i = 0; i < SPA_N_ELEMENTS(target_keys); i++) {
+			if (key && !spa_streq(key, target_keys[i]))
+				continue;
+			pw_properties_set(fs->metadata, target_keys[i], value);
+			if ((fs->echoes & (1u << i)) &&
+				spa_streq(value, pw_properties_get(fs->pending, target_keys[i]))) {
+				fs->echoes &= ~(1u << i);
+				continue;
+			}
+			pw_properties_set(fs->target, target_keys[i], value);
+			/* A move from another metadata client may race our temporary move.
+			 * Replay it once saving is enabled again. */
+			if (fs->guarded)
+				fs->manual = true;
+		}
+		if (fs->manual)
+			promote_stream(fs);
+		return;
+	}
+}
+
+int filter_move_stream(
+	struct client *client, struct pw_manager_object *object, int target_id, int64_t target_serial)
+{
+	struct filter_stream *fs;
+	int res;
+	/* A deferred move must have the same permissions as an immediate one. */
+	if (!SPA_FLAG_IS_SET(object->permissions, PW_PERM_M))
+		return -EACCES;
+	if (client->metadata_default == NULL)
+		return -ENOTSUP;
+	if (!SPA_FLAG_IS_SET(client->metadata_default->permissions, PW_PERM_W | PW_PERM_X))
+		return -EACCES;
+	if (client->metadata_default->proxy == NULL)
+		return -ENOENT;
+	for (fs = client->impl->filter_streams; fs; fs = fs->next) {
+		if (fs->stream->id != object->id || (!fs->automatic && fs->phase == MOVE_IDLE))
+			continue;
+		fs->manual = true;
+		pw_properties_setf(fs->target, METADATA_TARGET_NODE, "%d", target_id);
+		pw_properties_setf(fs->target, METADATA_TARGET_OBJECT, "%" PRIi64, target_serial);
+		promote_stream(fs);
+		filter_process(client->impl);
+		return 0;
+	}
+	if ((res = pw_manager_set_metadata(client->manager, client->metadata_default, object->id,
+		     METADATA_TARGET_NODE, SPA_TYPE_INFO_BASE "Id", "%d", target_id)) < 0)
+		return res;
+	return pw_manager_set_metadata(client->manager, client->metadata_default, object->id,
+		METADATA_TARGET_OBJECT, SPA_TYPE_INFO_BASE "Id", "%" PRIi64, target_serial);
+}
+
+void filter_process(struct impl *impl)
+{
+	struct filter_stream *fs, *other;
+
+	/* Resolve underlying routes and run heuristics before pairing streams. */
+	for (fs = impl->filter_streams; fs; fs = fs->next) {
+		struct stream *s = fs->stream;
+		struct pw_manager_object *node, *master;
+		const struct pw_properties *props = pw_stream_get_properties(s->stream);
+		if (!fs->filter && !fs->automatic && fs->phase == MOVE_IDLE && !fs->manual &&
+			!pw_properties_get(props, "filter.want") &&
+			!pw_properties_get(props, "filter.apply")) {
+			fs->wanted = false;
+			fs->master = 0;
+			continue;
+		}
+		node = stream_object(s);
+		if (node == NULL || advance_move(fs, node))
+			continue;
+		if (fs->manual) {
+			master = find_master(fs);
+			fs->destination = master ? master->serial : 0;
+			write_targets(s->client, s->id, fs->target);
+			fs->manual = false;
+			fs->automatic = false;
+			fs->master = 0;
+			fs->wanted = false;
+			fs->phase = MOVE_USER;
+			filter_unref(fs->filter);
+			fs->filter = NULL;
+			continue;
+		}
+		master = find_master(fs);
+		fs->master = master ? master->serial : 0;
+		fs->wanted =
+			master && wants_echo_cancel(fs, master) &&
+			!spa_atob(pw_properties_get(
+				pw_stream_get_properties(s->stream), PW_KEY_NODE_DONT_RECONNECT)) &&
+			!spa_atob(pw_properties_get(pw_stream_get_properties(s->stream), "node.dont-move")) &&
+			(s->direction == PW_DIRECTION_OUTPUT ? pw_manager_object_is_sink(master)
+							     : pw_manager_object_is_source(master)) &&
+			!spa_streq(object_property(master, "pulse.filter"), "echo-cancel");
+	}
+	for (fs = impl->filter_streams; fs; fs = fs->next) {
+		struct stream *s = fs->stream;
+		struct pw_manager_object *master, *dev;
+		struct filter *f = NULL;
+		const char *parameters;
+
+		if ((!fs->wanted && !fs->filter && !fs->automatic) || !stream_object(s) ||
+			fs->phase != MOVE_IDLE || fs->manual)
+			continue;
+		master = find_serial(s->client, fs->master);
+		if (master == NULL) {
+			filter_unref(fs->filter);
+			fs->filter = NULL;
+			if (fs->automatic)
+				begin_move(fs, NULL, true);
+			continue;
+		}
+		/* Monitor/direct recording and immovable streams must stay where the
+		 * client put them. Do not accidentally construct an AEC feedback loop. */
+		if (fs->wanted && impl->defs.allow_module_loading) {
+			struct filter_stream *capture = NULL, *playback = NULL;
+			struct pw_manager_object *source_master, *sink_master;
+			/* All members of a group use the same master pair. A user move
+			 * promotes that stream, making its new master authoritative. */
+			for (other = impl->filter_streams; other; other = other->next) {
+				if (!other->stream->stream || !other->wanted || !other->master ||
+					!same_group(fs, other))
+					continue;
+				if (!capture && other->stream->direction == PW_DIRECTION_INPUT)
+					capture = other;
+				if (!playback && other->stream->direction == PW_DIRECTION_OUTPUT)
+					playback = other;
+			}
+			if (capture && playback) {
+				/* Use the capture side's parameters consistently for both halves. */
+				source_master = find_serial(capture->stream->client, capture->master);
+				sink_master = find_serial(playback->stream->client, playback->master);
+				if (source_master == NULL || sink_master == NULL)
+					continue;
+				parameters =
+					pw_properties_get(pw_stream_get_properties(capture->stream->stream),
+						"filter.apply.echo-cancel.parameters");
+				if (parameters == NULL)
+					parameters = pw_properties_get(
+						pw_stream_get_properties(playback->stream->stream),
+						"filter.apply.echo-cancel.parameters");
+				if (parameters == NULL)
+					parameters = object_property(
+						source_master, "filter.apply.echo-cancel.parameters");
+				if (parameters == NULL)
+					parameters = object_property(
+						sink_master, "filter.apply.echo-cancel.parameters");
+				f = get_filter(fs, playback->master, capture->master, parameters);
+			}
+		}
+		filter_unref(fs->filter);
+		fs->filter = f;
+		dev = filter_device(fs);
+		if (dev && (!fs->automatic || fs->destination != dev->serial))
+			begin_move(fs, dev, false);
+		else if (fs->automatic && (f == NULL || f->failed || f->module == NULL))
+			begin_move(fs, master, true);
+	}
+}
