+static void test_explicit_update_and_unload(void)
+{
+	struct test_stream *ts;
+	struct spa_dict_item item = SPA_DICT_ITEM_INIT("filter.apply", "echo-cancel");
+	setup();
+	settle();
+	ts = &test.streams[0];
+	/* Writing the same value still changes ownership of filter.apply. */
+	filter_stream_properties_changed(&ts->stream, &SPA_DICT_INIT(&item, 1));
+	spa_assert_se(!ts->stream.filter->heuristic);
+	test.client.default_sink = "phone";
