+static void test_external_move_and_guard(void)
+{
+	struct test_stream *ts;
+	setup();
+	settle();
+	ts = &test.streams[0];
+	/* An external metadata writer's move must eventually be saved, even
+	 * though its first write arrives while the automatic route is guarded. */
+	pw_manager_set_metadata(&test.manager, test.client.metadata_default, ts->stream.id,
+		METADATA_TARGET_NODE, SPA_TYPE_INFO_BASE "Id", "%u", 3u);
+	pw_manager_set_metadata(&test.manager, test.client.metadata_default, ts->stream.id,
+		METADATA_TARGET_OBJECT, SPA_TYPE_INFO_BASE "Id", "%u", 103u);
+	settle();
+	spa_assert_se(ts->peer == 103);
+	spa_assert_se(spa_streq(ts->saved, "103"));
+	spa_assert_se(!ts->stream.filter->guarded);
+	cleanup();
+
+	setup();
+	ts = &test.streams[0];
+	pw_properties_set(ts->props, "state.restore-target", "false");
+	settle();
+	pw_properties_set(ts->props, "filter.want", NULL);
+	settle();
+	spa_assert_se(!ts->stream.filter->guarded);
+	spa_assert_se(spa_streq(pw_properties_get(ts->props, "state.restore-target"), "false"));
+	cleanup();
+
+	setup();
+	test.impl.defs.allow_module_loading = false;
+	settle();
+	spa_assert_se(test.loads == 0);
+	spa_assert_se(test.writes == 0);
+	cleanup();
+}
